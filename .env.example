# Copy to .env for local use. On Render / Railway, set these in the dashboard instead — never commit a real .env.
# Generate a long random secret, e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<redacted>
PORT=3000
# Optional: path to the SQLite file. Default is ./mannyo.db next to server.js
# DATABASE_URL=<redacted>
